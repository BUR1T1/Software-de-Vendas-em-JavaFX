<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.app.controller.Usuario.UsuarioController"
            style="-fx-background-color: transparent; -fx-background: transparent;">
    <content>
        <VBox spacing="20" style="-fx-background-color: #0f172a;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Gestão de Usuários" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #fb923c;"/>

            <GridPane hgap="10" vgap="10" style="-fx-background-color: #1e293b; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10; -fx-border-width: 1;">
                <Label text="Nome Completo:" style="-fx-text-fill: #94a3b8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNome" promptText="Ex: João Silva" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"
                           style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-background-radius: 6; -fx-border-radius: 6;"/>

                <Label text="Login/Usuário:" style="-fx-text-fill: #94a3b8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtLogin" promptText="joao.silva" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-background-radius: 6; -fx-border-radius: 6;"/>

                <Label text="Senha:" style="-fx-text-fill: #94a3b8;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <PasswordField fx:id="txtSenha" promptText="••••••••" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-background-radius: 6; -fx-border-radius: 6;"/>

                <Label text="Perfil:" style="-fx-text-fill: #94a3b8;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cmbPerfil" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"
                          style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc;"/>

                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Button text="Salvar Novo" onAction="#salvar" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="Limpar" onAction="#limpar" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="lblMensagem" GridPane.columnIndex="1" GridPane.rowIndex="5" style="-fx-text-fill: #fb923c;"/>
            </GridPane>

            <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #1e293b; -fx-table-cell-border-color: #334155; -fx-control-inner-background: #1e293b;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="250"/>
                    <TableColumn fx:id="colLogin" text="Usuário" prefWidth="150"/>
                    <TableColumn fx:id="colPerfil" text="Perfil" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </content>
</ScrollPane>
