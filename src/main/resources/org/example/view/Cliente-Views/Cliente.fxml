<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17"
            fx:controller="org.example.app.controller.Cliente.ClienteController"
            style="-fx-background-color: #F1F5F9;">

    <top>
        <VBox spacing="0" style="-fx-background-color: white; -fx-border-color: #0F172A; -fx-border-width: 0 0 2.5 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <padding>
                        <Insets top="25" right="30" bottom="25" left="30"/>
                    </padding>
                    <children>
                        <VBox spacing="5">
                            <Label text="GESTÃO DE CLIENTES" textFill="#0F172A" style="-fx-font-weight: 900; -fx-letter-spacing: 1px;">
                                <font>
                                    <Font size="20.0" />
                                </font>
                            </Label>
                            <Line endX="50.0" stroke="#2563EB" strokeWidth="3.0" />
                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button text="+ NOVO CLIENTE" onAction="#novoCadastro" prefHeight="45"
                                style="-fx-background-color: #0F172A;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-padding: 0 25;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 25;">
            <children>

                <HBox spacing="15" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-width: 1;">
                    <children>
                        <TextField fx:id="txtPesquisar"
                                   prefWidth="350"
                                   prefHeight="40"
                                   promptText="🔍 Buscar por nome ou CPF..."
                                   style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 5;"/>

                        <Region HBox.hgrow="ALWAYS" />

                        <Button text="EDITAR" onAction="#editar" prefHeight="35"
                                style="-fx-background-color: white; -fx-text-fill: #0F172A; -fx-font-weight: bold; -fx-border-color: #0F172A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-cursor: hand;"/>

                        <Button text="INATIVAR" onAction="#inativarCliente" prefHeight="35"
                                style="-fx-background-color: #FFF1F2; -fx-text-fill: #E11D48; -fx-font-weight: bold; -fx-border-color: #FECDD3; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-cursor: hand;"/>
                    </children>
                </HBox>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                         style="-fx-background-color: white;
                                -fx-background-radius: 12;
                                -fx-border-color: #0F172A;
                                -fx-border-width: 2.5;
                                -fx-border-radius: 10;
                                -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.1), 20, 0, 0, 10);">
                    <tabs>
                        <Tab text="  CLIENTES ATIVOS  ">
                            <content>
                                <VBox style="-fx-padding: 15;">
                                    <TableView fx:id="tabelaClientes" VBox.vgrow="ALWAYS"
                                               style="-fx-background-color: transparent; -fx-padding: 5;">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                        <columns>
                                            <TableColumn fx:id="colId" text="ID" prefWidth="70" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="colNome" text="NOME COMPLETO" prefWidth="300" />
                                            <TableColumn fx:id="colCpf" text="DOCUMENTO (CPF)" prefWidth="180" style="-fx-alignment: CENTER;"/>
                                            <TableColumn fx:id="colTelefone" text="CONTATO / WHATSAPP" prefWidth="180" style="-fx-alignment: CENTER;"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </content>
                        </Tab>

                        <Tab text="  CLIENTES INATIVOS  ">
                            <content>
                                <VBox spacing="10" style="-fx-padding: 15;">
                                    <HBox alignment="CENTER_RIGHT">
                                        <Button text="REATIVAR SELECIONADOS" onAction="#reativar"
                                                style="-fx-background-color: #DCFCE7;
                                                       -fx-text-fill: #166534;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 5;
                                                       -fx-border-color: #BBF7D0;
                                                       -fx-cursor: hand;"/>
                                    </HBox>
                                    <TableView fx:id="tabelaInativos" VBox.vgrow="ALWAYS"
                                               style="-fx-background-color: transparent;">
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                        <columns>
                                            <TableColumn text="ID" prefWidth="70" style="-fx-alignment: CENTER;"><cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory></TableColumn>
                                            <TableColumn text="NOME COMPLETO" prefWidth="300"><cellValueFactory><PropertyValueFactory property="nome"/></cellValueFactory></TableColumn>
                                            <TableColumn text="CPF" prefWidth="180" style="-fx-alignment: CENTER;"><cellValueFactory><PropertyValueFactory property="cpf"/></cellValueFactory></TableColumn>
                                            <TableColumn text="TELEFONE" prefWidth="180" style="-fx-alignment: CENTER;"><cellValueFactory><PropertyValueFactory property="telefone"/></cellValueFactory></TableColumn>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </center>
</BorderPane>