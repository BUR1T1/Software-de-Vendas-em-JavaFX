<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefWidth="500" prefHeight="400"
      style="-fx-background-color: #1e293b; -fx-border-color: #f97316; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.app.util.BuscaModalController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <children>
        <Label fx:id="lblTitulo" text="PESQUISAR"
               style="-fx-font-weight: bold; -fx-text-fill: #fb923c; -fx-font-size: 16px;"/>

        <TextField fx:id="txtFiltro" onKeyReleased="#filtrar" prefHeight="40"
                   promptText="Digite para filtrar..."
                   style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-background-radius: 5; -fx-border-radius: 5; -fx-focus-color: #f97316;"/>

<TableView fx:id="tblResultados" VBox.vgrow="ALWAYS"
                   onMouseClicked="#verificarCliqueDuplo"
                   style="-fx-background-color: transparent; -fx-table-cell-border-color: #334155; -fx-control-inner-background: #1e293b; -fx-selection-bar: #f97316; -fx-selection-bar-non-focused: #334155;">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button text="CANCELAR" onAction="#fechar"
                    style="-fx-background-color: #334155; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
            <Button text="SELECIONAR" onAction="#confirmar"
                    style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
        </HBox>
    </children>
</VBox>
