<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.app.controller.login.LoginController">

    <children>
        <!-- Círculos decorativos de fundo -->
        <Circle centerX="80" centerY="80" fill="rgba(249,115,22,0.12)" radius="220" />
        <Circle centerX="820" centerY="600" fill="rgba(249,115,22,0.08)" radius="300" />
        <Circle centerX="700" centerY="120" fill="rgba(255,255,255,0.08)" radius="120" />

        <HBox alignment="CENTER" prefHeight="725.0" prefWidth="975.0" spacing="0.0">
            <children>
                <!-- Documento de login -->
                <VBox alignment="CENTER" maxHeight="540.0" maxWidth="440.0" prefHeight="540.0" prefWidth="365.0" spacing="0.0" style="-fx-background-color: #0000ff00; -fx-background-radius: 24; -fx-border-width: 1; -fx-border-radius: 24; -fx-effect: dropshadow(three-pass-box, rgba(249,115,22,0.25), 40, 0, 0, 15);">

                    <children>

                        <VBox prefHeight="292.0" prefWidth="401.0" spacing="18.0">
                            <padding>
                                <Insets bottom="40.0" left="40.0" right="40.0" top="10.0" />
                            </padding>
                            <children>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;" text="USUÁRIO:" textFill="WHITE" />
                                        <TextField fx:id="txtUsuario" prefHeight="50.0" promptText="Digite seu usuário..." style="-fx-background-color: #0f172a;                                                           -fx-border-color: #334155;                                                           -fx-border-width: 1.5;                                                           -fx-border-radius: 12;                                                           -fx-background-radius: 12;                                                           -fx-padding: 0 16;                                                           -fx-font-size: 14px;                                                           -fx-text-fill: #f8fafc;                                                           -fx-prompt-text-fill: #64748b;                                                           -fx-focus-color: #f97316;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;" text="SENHA:" textFill="WHITE" />
                                        <PasswordField fx:id="txtSenha" prefHeight="50.0" promptText="••••••••" style="-fx-background-color: #0f172a;                                                               -fx-border-color: #334155;                                                               -fx-border-width: 1.5;                                                               -fx-border-radius: 12;                                                               -fx-background-radius: 12;                                                               -fx-padding: 0 16;                                                               -fx-font-size: 14px;                                                               -fx-text-fill: #f8fafc;                                                               -fx-prompt-text-fill: #64748b;                                                               -fx-focus-color: #f97316;" />
                                    </children>
                                </VBox>

                                <Region prefHeight="4" />

                                <Button maxWidth="Infinity" onAction="#entrar" prefHeight="52.0" style="-fx-background-color: linear-gradient(to right, #f97316, #fb923c);                                                -fx-text-fill: white;                                                -fx-font-weight: bold;                                                -fx-font-size: 14px;                                                -fx-background-radius: 12;                                                -fx-cursor: hand;                                                -fx-effect: dropshadow(three-pass-box, rgba(249,115,22,0.4), 12, 0, 0, 5);" text="ENTRAR" />

                                <Label fx:id="lblMensagem" alignment="CENTER" maxWidth="Infinity" textFill="#fb923c" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</StackPane>
