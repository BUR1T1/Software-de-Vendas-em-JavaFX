<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" style="-fx-background-color: #0f172a;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="org.example.app.controller.venda.VendaHistoricoController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <children>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <children>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Histórico de Vendas" textFill="#fb923c">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Consulte e gerencie os registros de vendas da loja." textFill="#94a3b8">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <HBox spacing="10">
                    <Button onAction="#editarCliente" text="✎ Alterar Cliente"
                            style="-fx-background-color: #1e293b; -fx-text-fill: #fb923c; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" />
                    <Button onAction="#editarVendedor" text="✎ Alterar Vendedor"
                            style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 20;" />
                    <Button onAction="#cancelarVenda" text="✖ Cancelar Venda"
                            style="-fx-background-color: #3f1d1d; -fx-text-fill: #f87171; -fx-font-weight: bold; -fx-border-color: #7f1d1d; -fx-border-radius: 10; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 20;" />
                </HBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #1e293b; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-width: 1;">
            <children>
                <ComboBox fx:id="cmbFiltro" prefWidth="180" prefHeight="38"
                          style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-border-color: #334155; -fx-background-radius: 5;"/>
                <TextField fx:id="txtBusca" promptText="Digite o termo de busca..." HBox.hgrow="ALWAYS" prefHeight="38"
                           style="-fx-background-color: #0f172a; -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #64748b; -fx-border-color: #334155; -fx-background-radius: 5; -fx-focus-color: #f97316;"/>
                <Button text="🔍 Buscar" onAction="#buscar" prefHeight="38" prefWidth="120"
                        style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </children>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-background-radius: 20; -fx-border-color: #334155; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(249,115,22,0.1), 20, 0, 0, 10);">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
<TableView fx:id="tblHistorico" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-control-inner-background: #1e293b; -fx-table-cell-border-color: #334155; -fx-selection-bar: #f97316; -fx-selection-bar-non-focused: #334155;">
<columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colData" prefWidth="180.0" text="Data e Hora" />
                        <TableColumn fx:id="colCliente" prefWidth="250.0" text="Cliente" />
                        <TableColumn fx:id="colVendedor" prefWidth="200.0" text="Vendedor" />
                        <TableColumn fx:id="colTotal" prefWidth="150.0" text="Total (R$)" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                        <TableColumn fx:id="colImprimir" prefWidth="70.0" text="Ação" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
